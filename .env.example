# ============ A07 企业数据底座智能问析 Agent 系统 环境变量样例 ============
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，严禁提交真实 Key（红线 R3）

# ---- LLM 主力（小米 MiMo，OpenAI 兼容；base_url 以 mimo.mi.com 控制台实际发放为准）----
LLM_PRIMARY_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=mimo-v2.5-pro
LLM_LIGHT_MODEL=mimo-v2.5

# ---- LLM 兜底（主力超时/限流时自动切换）----
LLM_FALLBACK_BASE_URL=https://api.deepseek.com/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=deepseek-chat

# ---- Embedding（P2 向量检索启用；Qwen text-embedding-v4）----
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4

# ---- MySQL（业务库只读账号，红线 R1：引擎仅持有只读凭据）----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=mes_demo
MYSQL_READONLY_USER=mes_readonly
MYSQL_READONLY_PASSWORD=

# ---- Agent 引擎 ----
AGENT_PORT=8100
SQL_MAX_LIMIT=500
SQL_TIMEOUT_SECONDS=20
SANDBOX_TIMEOUT_SECONDS=30

# ---- Spring Boot 业务服务 ----
SERVER_PORT=8080
JWT_SECRET=change-me-in-real-env
JWT_EXPIRE_HOURS=2

# ---- 前端开发代理 ----
VITE_API_BASE=/api
